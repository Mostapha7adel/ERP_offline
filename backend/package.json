{
  "name": "ledgerflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LedgerFlow — Professional offline accounting backend API",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "ledgerflow-backend": "dist/server.cjs"
  },
  "pkg": {
    "assets": [
      "node_modules/@prisma/engines/**/*",
      "node_modules/.prisma/client/**/*",
      "prisma/schema.prisma",
      "prisma/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-x64",
      "node22-macos-arm64"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs --external:@prisma/engines --external:bcryptjs",
    "package": "pkg . --target node22-win-x64 --output dist/ledgerflow-backend.exe",
    "package:mac": "pkg . --target node22-macos-arm64 --output dist/ledgerflow-backend-arm64 && pkg . --target node22-macos-x64 --output dist/ledgerflow-backend-x64",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}

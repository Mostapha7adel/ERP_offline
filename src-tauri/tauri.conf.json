{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LedgerFlow",
  "version": "1.0.2",
  "identifier": "com.ledgerflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LedgerFlow — Accounting",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3000 http://*:3000 ws://localhost:1420 http://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline accounting desktop system",
    "longDescription": "LedgerFlow is a professional, fully-offline accounting desktop application.",
    "externalBin": ["binaries/ledgerflow-backend"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "languages": ["English", "Arabic"],
        "startMenuFolder": "LedgerFlow",
        "compression": "lzma"
      }
    }
  }
}
